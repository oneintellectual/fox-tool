{
  "name": "fox-tool-module-text-counter",
  "version": "1.0.0",
  "description": "Fox Tool 示例模块 - 文本统计器",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --format=esm --platform=browser --target=es2020 --jsx=automatic --outfile=dist/client.js",
    "build:server": "esbuild src/index.tsx --bundle --format=esm --platform=node --target=es2020 --jsx=automatic --external:react --external:react-dom --external:react-dom/client --outfile=dist/server.js"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
